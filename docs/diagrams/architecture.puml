@startuml
title MirrorMesh — parallel platforms, native Android TV primary + browser fallback
skinparam componentStyle rectangle
skinparam shadowing false

package "P2 concurrently built capture/send adapters" {
  component "Windows\nWGC + Media Foundation" as WIN
  component "Linux\nPipeWire + GPU codec" as LNX
  component "Android phone\nMediaProjection + MediaCodec" as AND
  component "iOS/iPadOS\nScreenCaptureKit* + VideoToolbox" as IOS
}
package "P1 shared contract (CORE-owned)" {
  component "mm-domain / mm-ports\nState, consent, capabilities" as CORE
  component "mm-protocol / mm-security\nQR + authenticated signaling" as AUTH
  component "mm-runtime + WebRTC\nICE / DTLS / SRTP" as RTC
  database "SQLite trusted peers" as DB
  CORE --> AUTH
  AUTH --> RTC
  CORE --> DB
}
package "P2 receivers — all developed concurrently" {
  component "Desktop / mobile natives\nWIN LNX AND IOS" as NATIVE
  component "Android TV native APK\nPRIMARY TV receiver\nMediaCodec + D-pad" as TV
  component "TV Browser HTTPS app\nFALLBACK if WebRTC + H264" as WEB
}
WIN --> RTC : native encoded buffers
LNX --> RTC : native encoded buffers
AND --> RTC : native encoded buffers
IOS --> RTC : native encoded buffers
RTC --> NATIVE : encrypted stream
RTC --> TV : encrypted stream
RTC --> WEB : encrypted stream
note bottom of IOS
* Verified OS/API and system picker required.
Older-version support is an explicit gate.
end note
note bottom of TV
Installed native Android TV is not
equivalent to Cast/Miracast.
end note
note bottom of WEB
Browser fallback requires real TV
browser capability/HTTPS testing.
end note
@enduml
