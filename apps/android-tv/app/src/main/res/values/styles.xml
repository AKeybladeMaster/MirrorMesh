<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:colorButtonNormal">@color/button_background</item>
        <item name="android:buttonStyle">@style/MeshButton</item>
        <item name="android:colorControlHighlight">#4039D7D0</item>
    </style>
    <style name="MeshButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/tv_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="MeshButton.Primary">
        <item name="android:background">@drawable/primary_button_background</item>
        <item name="android:textColor">@color/primary_button_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="MeshText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="MeshText.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="MeshText.Heading">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="MeshCheckBox" parent="android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
