<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="MirrorMesh TV receiver"
            android:text="MIRRORMESH  /  TV RECEIVER"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pair a sender"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/session_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:text="Pairing is stopped"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/service_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="18dp"
            android:accessibilityLiveRegion="polite"
            android:text="Start the receiver to create a short-lived pairing code. Video streaming is not connected yet."
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/invitation_qr"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:background="#FFFFFFFF"
                    android:contentDescription="Pairing QR code"
                    android:padding="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/invitation_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:maxLines="3"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/qr_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Short-lived receiver invitation. Sender-side integration is pending; pairing alone does not start video."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/refresh_qr_button"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text="Refresh pairing code"
                    android:textAllCaps="false"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Receiver network address"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/endpoint_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/tv_button_background"
                    android:contentDescription="Choose the TV network address"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/start_receiver_button"
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/tv_button_background"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:focusedByDefault="true"
                        android:minWidth="190dp"
                        android:text="Start receiver"
                        android:textAllCaps="false"
                        android:textSize="17sp" />

                    <Button
                        android:id="@+id/stop_receiver_button"
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:background="@drawable/tv_button_background"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:minWidth="170dp"
                        android:text="Stop receiver"
                        android:textAllCaps="false"
                        android:textSize="17sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/request_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="No sender request is waiting."
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <CheckBox
                    android:id="@+id/grant_view"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text="Allow view"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/grant_send"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text="Allow send"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/grant_annotate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:text="Allow annotate"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/approve_button"
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/tv_button_background"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:minWidth="180dp"
                        android:text="Approve selected"
                        android:textAllCaps="false"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/reject_button"
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:background="@drawable/tv_button_background"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:minWidth="150dp"
                        android:text="Reject"
                        android:textAllCaps="false"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/wait_button"
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/tv_button_background"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:minWidth="180dp"
                        android:text="Wait for sender"
                        android:textAllCaps="false"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/close_channel_button"
                        android:layout_width="wrap_content"
                        android:layout_height="58dp"
                        android:background="@drawable/tv_button_background"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:minWidth="215dp"
                        android:text="Close channel"
                        android:textAllCaps="false"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/help_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="Requests show the sender name, source address and key fingerprint. Permission boxes start unchecked."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
