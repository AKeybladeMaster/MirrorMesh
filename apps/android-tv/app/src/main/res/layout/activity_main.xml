<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="42dp"
        android:paddingEnd="64dp"
        android:paddingBottom="42dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="MirrorMesh TV receiver"
            android:text="MIRRORMESH  /  TV RECEIVER"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Your screen,\nready to share."
            android:textColor="@color/text_primary"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/session_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:accessibilityLiveRegion="polite"
            android:text="No active session"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/service_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="27dp"
            android:accessibilityLiveRegion="polite"
            android:text="Local demonstration only. No network or video is connected."
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/demo_request_button"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:minWidth="180dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:focusedByDefault="true"
                android:text="Show local request"
                android:textAllCaps="false"
                android:textSize="18sp" />

            <Button
                android:id="@+id/accept_button"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:minWidth="150dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="Accept"
                android:textAllCaps="false"
                android:textSize="18sp" />

            <Button
                android:id="@+id/reject_button"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:minWidth="150dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="Reject"
                android:textAllCaps="false"
                android:textSize="18sp" />

            <Button
                android:id="@+id/stop_button"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:minWidth="150dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="Disconnect"
                android:textAllCaps="false"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/details_button"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/tv_button_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="Connection details"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/help_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:accessibilityLiveRegion="polite"
                android:text="Choose Show local request, then Accept or Reject it with the remote. This demonstration changes local UI state only; no sender can connect and no screen is captured."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
