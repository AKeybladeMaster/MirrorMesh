<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/screen_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/MeshText.Secondary" android:text="@string/app_name" />
        <TextView style="@style/MeshText.Heading" android:layout_marginTop="8dp"
            android:text="@string/receiver_title" android:textSize="30sp" />
        <TextView android:id="@+id/session_state" style="@style/MeshText.Heading"
            android:layout_marginTop="24dp" android:accessibilityLiveRegion="polite"
            android:text="@string/pairing_stopped" android:textColor="@color/accent" />
        <TextView android:id="@+id/service_state" style="@style/MeshText.Secondary"
            android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite"
            android:text="@string/pairing_idle_help" />
        <LinearLayout android:id="@+id/network_setup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical">
            <TextView style="@style/MeshText" android:labelFor="@id/endpoint_spinner"
                android:text="@string/network_label" android:textStyle="bold" />
            <TextView style="@style/MeshText.Secondary" android:layout_marginTop="4dp"
                android:text="@string/network_help" />
            <Spinner android:id="@+id/endpoint_spinner" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp"
                android:layout_marginTop="8dp" android:spinnerMode="dialog"
                android:prompt="@string/network_label" android:focusable="true" />
        </LinearLayout>
        <Button android:id="@+id/start_receiver_button" style="@style/MeshButton.Primary"
            android:text="@string/start_receiver" />
        <LinearLayout android:id="@+id/pairing_columns" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal"
            android:baselineAligned="false">
            <LinearLayout android:id="@+id/pairing_code_panel" android:layout_width="320dp"
                android:layout_height="wrap_content" android:layout_marginEnd="28dp" android:orientation="vertical">
                <TextView style="@style/MeshText.Heading" android:text="@string/invitation_title" />
                <TextView android:id="@+id/qr_help" style="@style/MeshText.Secondary"
                    android:layout_marginTop="8dp" android:text="@string/invitation_help" />
                <Button android:id="@+id/share_invitation_button" style="@style/MeshButton.Primary"
                    android:text="@string/share_invitation" />
                <Button android:id="@+id/copy_invitation_button" style="@style/MeshButton"
                    android:text="@string/copy_invitation" />
                <ImageView android:id="@+id/invitation_qr" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:adjustViewBounds="true" android:maxHeight="280dp"
                    android:scaleType="fitCenter" android:layout_marginTop="16dp" android:background="#FFFFFF"
                    android:padding="12dp" android:contentDescription="@string/pairing_accessibility_qr" android:visibility="gone" />
                <TextView android:id="@+id/invitation_text" style="@style/MeshText.Secondary"
                    android:layout_marginTop="8dp" android:ellipsize="middle" android:maxLines="2"
                    android:textIsSelectable="true" android:contentDescription="@string/invitation_link_description"
                    android:visibility="gone" />
                <Button android:id="@+id/refresh_qr_button" style="@style/MeshButton"
                    android:text="@string/refresh_invitation" />
            </LinearLayout>
            <LinearLayout android:id="@+id/pairing_controls" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/MeshText.Heading" android:text="@string/approval_title" />
                <TextView android:id="@+id/request_details" style="@style/MeshText"
                    android:layout_marginTop="12dp" android:text="@string/no_sender" android:textIsSelectable="true" />
                <TextView android:id="@+id/help_text" style="@style/MeshText.Secondary"
                    android:layout_marginTop="12dp" android:text="@string/approval_help" />
                <CheckBox android:id="@+id/grant_view" style="@style/MeshCheckBox"
                    android:text="@string/grant_view_label" android:visibility="gone" />
                <CheckBox android:id="@+id/grant_send" style="@style/MeshCheckBox"
                    android:text="@string/grant_send_label" android:visibility="gone" />
                <CheckBox android:id="@+id/grant_annotate" style="@style/MeshCheckBox"
                    android:text="@string/grant_annotate_label" android:visibility="gone" />
                <Button android:id="@+id/approve_button" style="@style/MeshButton.Primary" android:text="@string/approve_selected" />
                <Button android:id="@+id/reject_button" style="@style/MeshButton" android:text="@string/reject_sender" />
                <Button android:id="@+id/wait_button" style="@style/MeshButton.Primary" android:text="@string/wait_sender" />
                <Button android:id="@+id/close_channel_button" style="@style/MeshButton" android:text="@string/disconnect_sender" />
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/stop_receiver_button" style="@style/MeshButton"
            android:layout_marginTop="24dp" android:text="@string/stop_receiver" />
    </LinearLayout>
</ScrollView>
