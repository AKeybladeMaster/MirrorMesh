<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/tv_button_background" />
    <item android:state_focused="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/focus_outline" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/focus_outline" /><corners android:radius="12dp" /></shape>
    </item>
    <item><shape><solid android:color="@color/accent" /><corners android:radius="12dp" /></shape></item>
</selector>
